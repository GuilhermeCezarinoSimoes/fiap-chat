# Variáveis do aplicativo mobile (Expo). Copie para .env e ajuste.
# Nenhuma delas é secreta: o app NUNCA recebe credenciais administrativas.

# URL pública (HTTPS) da API de notificações publicada na Vercel
EXPO_PUBLIC_API_URL=https://fiap-chat-api.vercel.app

# ID do projeto no EAS (gerado por `npx eas-cli@latest init`), usado para obter o Expo Push Token
EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000

# Opcional: caminhos alternativos dos arquivos de configuração nativa do Firebase
# GOOGLE_SERVICES_JSON=./google-services.json
# GOOGLE_SERVICE_INFO_PLIST=./GoogleService-Info.plist
