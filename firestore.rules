rules_version = '2';

// Regras do Cloud Firestore.
// Perfis completos, grupos, conversas individuais e tokens de dispositivos.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isNonEmptyString(value, maxSize) {
      return value is string && value.size() > 0 && value.size() <= maxSize;
    }

    // ---------------------------------------------------------------
    // Perfil completo: somente o próprio usuário lê e grava.
    // Outros usuários consultam o perfil pela API, que verifica se existe
    // conversa individual ou grupo em comum.
    // ---------------------------------------------------------------
    function validProfile(d) {
      return d.keys().hasOnly(['uid', 'name', 'email', 'phoneNumber', 'birthDate', 'photoUrl', 'createdAt'])
        && d.uid == request.auth.uid
        && isNonEmptyString(d.name, 60)
        && isNonEmptyString(d.email, 254)
        && d.phoneNumber is string && d.phoneNumber.matches('^[0-9]{10,13}$')
        && d.birthDate is string && d.birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.photoUrl is string && d.photoUrl.size() <= 2048
        && d.createdAt is int;
    }

    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid)
        && validProfile(request.resource.data)
        && request.resource.data.email == request.auth.token.email;
      allow update: if isSelf(uid)
        && validProfile(request.resource.data)
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;

      // Tokens de push: privados, nunca públicos.
      match /devices/{deviceId} {
        allow read, delete: if isSelf(uid);
        allow create, update: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['token', 'provider', 'platform', 'enabled', 'updatedAt'])
          && isNonEmptyString(request.resource.data.token, 512)
          && request.resource.data.provider == 'expo'
          && request.resource.data.platform in ['android', 'ios']
          && request.resource.data.enabled is bool
          && request.resource.data.updatedAt is int;
      }
    }

    // ---------------------------------------------------------------
    // Diretório público mínimo (nome e foto) para busca de usuários.
    // Não contém e-mail, celular ou data de nascimento.
    // ---------------------------------------------------------------
    match /userDirectory/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['uid', 'name', 'nameLower', 'photoUrl', 'updatedAt'])
        && request.resource.data.uid == uid
        && isNonEmptyString(request.resource.data.name, 60)
        && request.resource.data.nameLower == request.resource.data.name.lower()
        && request.resource.data.photoUrl is string && request.resource.data.photoUrl.size() <= 2048
        && request.resource.data.updatedAt is int;
      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // Conversa individual: id determinístico "direct_<uidMenor>_<uidMaior>"
    // impede duplicidade e conversa consigo mesmo.
    // ---------------------------------------------------------------
    match /directConversations/{conversationId} {
      // resource == null permite verificar se a conversa já existe.
      allow get: if signedIn()
        && (resource == null || request.auth.uid in resource.data.participantIds);
      // Consultas precisam filtrar por participantIds array-contains <uid>.
      allow list: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['id', 'type', 'participantIds', 'createdAt'])
        && request.resource.data.id == conversationId
        && request.resource.data.type == 'direct'
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.resource.data.participantIds[0] < request.resource.data.participantIds[1]
        && request.auth.uid in request.resource.data.participantIds
        && conversationId == 'direct_' + request.resource.data.participantIds[0] + '_' + request.resource.data.participantIds[1]
        && exists(/databases/$(database)/documents/userDirectory/$(request.resource.data.participantIds[0]))
        && exists(/databases/$(database)/documents/userDirectory/$(request.resource.data.participantIds[1]))
        && request.resource.data.createdAt is int;
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------
    // Grupos. O limite é verificado sobre o estado FINAL do documento
    // (request.resource), portanto nenhuma escrita — concorrente ou não —
    // consegue gravar mais membros do que memberLimit.
    // ---------------------------------------------------------------
    function validGroup(d) {
      return d.keys().hasOnly(['name', 'photoUrl', 'ownerId', 'memberIds', 'memberLimit', 'notificationPolicy', 'createdAt', 'updatedAt'])
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 50
        && d.photoUrl is string && d.photoUrl.size() <= 2048
        && d.memberLimit is int && d.memberLimit >= 2 && d.memberLimit <= 50
        && d.memberIds is list
        && d.memberIds.size() >= 2
        && d.memberIds.size() <= d.memberLimit
        && d.memberIds.toSet().size() == d.memberIds.size()
        && d.ownerId in d.memberIds
        && d.notificationPolicy in ['all_group_messages', 'mentioned_members', 'direct_messages_only', 'disabled']
        && d.createdAt is int
        && d.updatedAt is int;
    }

    match /groups/{groupId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn()
        && !groupId.matches('direct_.*')
        && validGroup(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && validGroup(request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    // Controle de idempotência das notificações: somente a API (Admin SDK).
    match /notificationDispatches/{dispatchId} {
      allow read, write: if false;
    }
  }
}
